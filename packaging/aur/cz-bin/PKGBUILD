# Maintainer: Piumal Nipun <piumalnipun9@gmail.com>
pkgname=cz-bin
pkgver=0.2.1
pkgrel=1
pkgdesc="Jump to directories by partial name: a cd/z replacement with frecency history and a fuzzy picker"
arch=('x86_64')
url="https://github.com/piumalnipun9/cz"
license=('MIT')
provides=('cz')
conflicts=('cz')
options=('!debug')
install=cz.install
source=("$url/releases/download/v$pkgver/cz-v$pkgver-x86_64-unknown-linux-musl.tar.gz")
sha256sums=('a7ec093611abb38cd722ac37466f1e3313611621fe55c560f26881605788a4ac')

package() {
  cd "cz-v$pkgver-x86_64-unknown-linux-musl"
  install -Dm755 cz "$pkgdir/usr/bin/cz"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
